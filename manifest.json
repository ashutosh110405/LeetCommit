{
  "manifest_version": 3,
  "name": "LeetCommit - GitHub PAT LeetCode Sync",
  "version": "1.0.0",
  "author": "ashutosh110405",
  "homepage_url": "https://github.com/ashutosh110405",
  "description": "Automatically sync your accepted LeetCode solutions to a dedicated GitHub repository using fine-grained Personal Access Tokens (PAT). No 3rd-party OAuth required.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "LeetCommit - GitHub Settings",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_ui": {
    "page": "welcome/welcome.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://leetcode.cn/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.cn/problems/*"
      ],
      "js": [
        "scripts/inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.cn/problems/*"
      ],
      "js": [
        "scripts/leetcode-parser.js",
        "scripts/content.js"
      ],
      "css": [
        "styles/toast.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon32.png",
        "assets/icon48.png"
      ],
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*"
      ]
    }
  ]
}

